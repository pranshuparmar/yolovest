# YoloVest Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Domain for SSL certificate (required)
DOMAIN=yolovest.example.com
LETSENCRYPT_EMAIL=your-email@example.com

# Zerodha Kite Connect (required for live trading)
KITE_API_KEY=
KITE_API_SECRET=

# Google Gemini API (for sentiment analysis, LLM trade review)
GEMINI_API_KEY=

# Telegram Bot (for alerts and remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model signing (optional, recommended if you use the dashboard model
# upload/import). Set the SAME random secret on every machine that trades or
# trains. When set, downloaded artifacts are HMAC-signed and the upload
# endpoint refuses to load any unsigned/forged .pkl — closing the
# malicious-pickle RCE on the model-upload boundary. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MODEL_SIGNING_KEY=
