# YoloVest Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Domain for SSL certificate (required)
DOMAIN=yolovest.ddnsfree.com
LETSENCRYPT_EMAIL=your-email@example.com

# Zerodha Kite Connect (required for live trading)
KITE_API_KEY=
KITE_API_SECRET=

# Google Gemini API (for sentiment analysis, LLM trade review)
GEMINI_API_KEY=

# Telegram Bot (for alerts and remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
