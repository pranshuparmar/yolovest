# YoloVest Docker Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Dashboard port (default: 8080)
DASHBOARD_PORT=8080

# Zerodha Kite Connect (required for live trading)
KITE_API_KEY=
KITE_API_SECRET=

# Google Gemini API (for sentiment analysis, LLM trade review)
GEMINI_API_KEY=

# Telegram Bot (for alerts and remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
