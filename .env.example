# YoloVest Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
#
# Used by both Docker Compose and direct Python runs.
# Existing environment variables take precedence.

# Dashboard ports — external ports mapped by nginx
DASHBOARD_PORT=7010
DASHBOARD_SSL_PORT=7443

# Zerodha Kite Connect (required for live trading)
KITE_API_KEY=
KITE_API_SECRET=

# Google Gemini API (for sentiment analysis, LLM trade review)
GEMINI_API_KEY=

# Telegram Bot (for alerts and remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
